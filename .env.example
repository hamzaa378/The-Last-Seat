# Copy to .env and change both secrets before exposing this project to others.
DB_PASSWORD=change_me_local_db_password
JWT_SECRET=replace_with_at_least_32_random_characters
HOLD_SECONDS=120

# Native Windows with no Redis service: set REDIS_ENABLED=0 in the
# PowerShell sessions that launch the API and background worker.
# Docker/Redis bonus default (enabled):
REDIS_ENABLED=1
